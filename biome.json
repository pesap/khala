{
	"$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"includes": ["src/**/*.ts", "extensions/pi-review/**/*.ts", "extensions/pi-clarify/**/*.ts"],
		"ignoreUnknown": false,
		"maxSize": 1048576
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineEnding": "lf",
		"lineWidth": 120,
		"useEditorconfig": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": "error",
			"complexity": "error",
			"correctness": "error",
			"performance": "error",
			"security": "error",
			"style": "error",
			"suspicious": "error"
		}
	},
	"javascript": {
		"formatter": {
			"arrowParentheses": "always",
			"bracketSameLine": false,
			"bracketSpacing": true,
			"jsxQuoteStyle": "double",
			"lineEnding": "lf",
			"lineWidth": 120,
			"quoteProperties": "asNeeded",
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"recommended": true,
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["src/**/*.ts", "extensions/pi-review/**/*.ts"],
			"linter": {
				"rules": {
					"correctness": {
						"noNodejsModules": "off",
						"useQwikValidLexicalScope": "off"
					}
				}
			}
		},
		{
			"includes": ["extensions/pi-review/**/*.ts", "extensions/pi-clarify/**/*.ts"],
			"linter": { "enabled": false }
		},
		{
			"includes": ["src/index.ts"],
			"linter": { "rules": { "style": { "noDefaultExport": "off" } } }
		}
	]
}
