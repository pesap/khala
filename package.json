{
  "name": "@pesap/khala",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Khala coding-agent extension with prompts and themes",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
    "khala": "./bin/khala.js"
  },
  "pi": {
    "extensions": [
      "./src/index.ts",
      "./extensions/pi-review/review.ts"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ],
    "skills": [
      "./skills/khala",
      "./skills/khala-executor",
      "./skills/herdr"
    ]
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "bin",
    "extensions",
    "prompts",
    "system-prompts",
    "templates",
    "themes",
    "assets",
    "skills/khala",
    "skills/khala-executor",
    "skills/herdr",
    "src"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc",
    "check": "biome check src extensions/pi-review && tsc --noEmit",
    "check:package-surface": "node --test test/package-surface.test.js",
    "dev": "tsc --watch",
    "test": "npm run build && node --test test/*.js"
  },
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=12.0.0"
  },
  "packageManager": "npm@12.0.0",
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "brace-expansion": "5.0.9",
      "undici": "8.9.0"
    }
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "jiti": "2.7.0",
    "nanoid": "6.0.0",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
