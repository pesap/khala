{
  "name": "@pesap/khala",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Khala coding-agent extension with prompts and themes",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "pi": {
    "extensions": [
      "./src/index.ts",
      "./extensions/pi-review/review.ts",
      "./extensions/pi-clarify/clarify.ts",
      "./extensions/khala-demo/demo.ts"
    ],
    "themes": [
      "./themes"
    ],
    "prompts": [
      "./prompts"
    ],
    "skills": [
      "./skills/khala"
    ]
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "extensions",
    "data/fixtures",
    "prompts",
    "system-prompts",
    "templates",
    "themes",
    "assets",
    "skills/khala",
    "src"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "lint": "oxlint --deny-warnings . && biome check .",
    "lint:oxlint": "oxlint --deny-warnings .",
    "lint:fix": "biome check --write",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "check:markdown": "node scripts/check-markdown-sentences.mjs",
    "dev": "tsc --watch",
    "test": "npm run build && node --test test/*.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "brace-expansion": "5.0.9"
    },
    "brace-expansion": "5.0.9"
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "protobufjs@7.6.5": true
  },
  "dependencies": {
    "nanoid": "6.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@oxlint/plugins": "1.79.0",
    "@types/node": "26.2.0",
    "oxlint": "1.79.0",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
