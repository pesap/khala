# Allow the CI sandbox launcher to create namespaces without disabling
# Ubuntu's global unprivileged-user-namespace restrictions.
# The SDK also creates namespaces inside bubblewrap for command isolation.
abi <abi/4.0>,
include <tunables/global>

profile khala-ci-bwrap /usr/bin/bwrap flags=(unconfined) {
  userns,
}
